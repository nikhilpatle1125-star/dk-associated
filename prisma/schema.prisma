generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       String @id @default(cuid())
  email    String @unique
  password String
}

model Property {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  type           String   // "PLOT" or "FLAT"
  price          Float
  priceLabel     String?  // e.g. "Negotiable", "All Inclusive"
  area           Float
  areaUnit       String   @default("sq.ft.")
  status         String   @default("AVAILABLE") // AVAILABLE, SOLD, ON_HOLD, BOOKED
  description    String   @default("")
  address        String   @default("")
  city           String   @default("")
  mapLink        String?
  photos         String   @default("[]") // JSON array of URLs
  layoutMapUrl   String?
  brochureUrl    String?
  virtualTourUrl String?  // New: 360 tour / video walkthrough link

  // Plot-specific fields
  plotDimensions String?
  facing         String?
  cornerPlot     Boolean  @default(false)
  boundaryWall   Boolean  @default(false)

  // Flat-specific fields
  bhk            String?
  floor          String?
  totalFloors    Int?
  furnishing     String?
  parking        Boolean  @default(false)

  featured       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SiteSettings {
  id           String  @id @default("singleton")
  companyName  String  @default("DK Associated")
  tagline      String  @default("Trusted plots & flats, built on transparency.")
  email        String  @default("")
  whatsapp     String  @default("")
  phone        String  @default("")
  address      String  @default("")
  mapLink      String  @default("")
  aboutText    String  @default("")
  logoUrl      String?
  heroImageUrl String?
  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?

  // New client-attracting metrics / highlights
  yearsExperience String @default("15+")
  happyClients    String @default("1,200+")
  verifiedProperties String @default("100%")
  expertSupport   String @default("24/7 Guidance")
}

model ContactMessage {
  id         String   @id @default(cuid())
  name       String
  phone      String
  email      String?
  message    String
  propertyId String?
  createdAt  DateTime @default(now())
}

model Slide {
  id        String   @id @default(cuid())
  imageUrl  String
  title     String   @default("")
  subtitle  String   @default("")
  linkUrl   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}
